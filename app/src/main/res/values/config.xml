<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Which name leads on the Sa card. English readers know C#3; Marathi and Hindi
         readers are likelier to think in harmonium pegs, so those builds put Kali 1 first
         and demote the Western note. -->
    <bool name="peg_name_leads">false</bool>

    <!-- The wordmark. The negative tracking is drawn for the Latin "mogra"; Devanagari
         needs neither the tracking nor the same size, and at 47sp मोगरा was wide enough to
         break across two lines. -->
    <integer name="wordmark_size_sp">47</integer>
    <integer name="wordmark_tracking_hundredths">-80</integer>

</resources>
